# .dockerignore file for Smart University

# Git
.git
.gitignore
.gitattributes

# Documentation
README.md
Docs/
*.md

# Build artifacts
bin/
obj/
out/
publish/

# IDE and editor files
.vs/
.vscode/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed

# Coverage directory used by tools like istanbul
coverage/

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Environment files (will be handled by docker-compose)
.env
.env.local
.env.development
.env.test
.env.production

# Database files
*.db
*.sqlite

# Temporary files
tmp/
temp/

# Docker files (avoid recursive copying)
Dockerfile*
docker-compose*
.dockerignore

# Migration files (will be applied at runtime)
Migrations/